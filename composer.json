{
    "name": "nodesol/apiguard",
    "description": "API Guard for Laravel",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Nodesol\\Apiguard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nodesol\\Apiguard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/auth": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/cache": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/contracts": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/http": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/support": "^10.0||^11.0||^12.0||^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.18.0|^10.12.0|^11.3.0",
        "pestphp/pest": "^3.8.0|^4.7.0|^5.3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nodesol\\Apiguard\\ApiguardServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
